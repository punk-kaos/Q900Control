def bytes_bits(data: bytes) -> np.ndarray:
    return np.unpackbits(np.frombuffer(data, dtype=np.uint8), bitorder="big")


def bits_bytes(bits: np.ndarray) -> bytes:
    bits = np.asarray(bits, dtype=np.uint8).reshape(-1)
    if len(bits) % 8:
        bits = np.pad(bits, (0, 8 - len(bits) % 8))
    return np.packbits(bits, bitorder="big").tobytes()


def sync_bits(value: int) -> np.ndarray:
    return int_bits(value, 48)


def dibit_levels(bits: np.ndarray) -> np.ndarray:
    pairs = np.asarray(bits, dtype=np.uint8).reshape(-1, 2)
    code = (pairs[:, 0] << 1) | pairs[:, 1]
    # 00=-1, 01=-3, 10=+1, 11=+3
    return np.take(np.asarray([-1.0, -3.0, 1.0, 3.0], dtype=np.float64), code)


def levels_bits(levels: np.ndarray, center: float, scale: float) -> np.ndarray:
    if abs(scale) < 1e-9:
        raise ValueError("DMR discriminator scale is zero")
    normalized = (np.asarray(levels, dtype=np.float64) - center) / scale
    code = np.empty(len(normalized), dtype=np.uint8)
    code[normalized < -2.0] = 1
    code[(normalized >= -2.0) & (normalized < 0.0)] = 0
    code[(normalized >= 0.0) & (normalized < 2.0)] = 2
    code[normalized >= 2.0] = 3
    out = np.empty(len(code) * 2, dtype=np.uint8)
    out[0::2] = code >> 1
    out[1::2] = code & 1
    return out


def _matrix_encode(value: int, matrix: np.ndarray, info_bits: int) -> np.ndarray:
    info = int_bits(value, info_bits)
    return (info @ matrix & 1).astype(np.uint8)


