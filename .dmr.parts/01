_GOLAY_CODEWORDS = np.stack([golay2087_encode(i) for i in range(256)])


def golay2087_decode(bits: np.ndarray) -> tuple[int, int]:
    bits = np.asarray(bits, dtype=np.uint8).reshape(20)
    distance = np.count_nonzero(_GOLAY_CODEWORDS != bits, axis=1)
    value = int(np.argmin(distance))
    errors = int(distance[value])
    if errors > 3:
        raise ValueError(f"uncorrectable Golay(20,8) word ({errors} bit distance)")
    return value, errors


def qr1676_encode(value: int) -> np.ndarray:
